# Gabarit — ne jamais commiter le vrai fichier avec des valeurs réelles.
# En pratique, le Secret est créé directement sur le VPS à partir du .env
# existant (voir k8s/create-secret.sh), jamais versionné.
apiVersion: v1
kind: Secret
metadata:
  name: diarra-secrets
  namespace: diarra
type: Opaque
stringData:
  JWT_SECRET: "changeme"
  REFRESH_SECRET: "changeme"
  # Connexion complète (le code lit DATABASE_URL en un seul morceau, voir
  # backend/cmd/server/main.go) — le mot de passe Postgres est encodé dedans.
  DATABASE_URL: "postgres://diarra:changeme@postgres:5432/diarra?sslmode=disable"
  POSTGRES_PASSWORD: "changeme"
  MINIO_ROOT_USER: "changeme"
  MINIO_ROOT_PASSWORD: "changeme"
  S3_ACCESS_KEY_ID: "changeme"
  S3_SECRET_ACCESS_KEY: "changeme"
  RESEND_API_KEY: ""
  RESEND_FROM: ""
  SMTP_HOST: ""
  SMTP_USER: ""
  SMTP_PASS: ""
  SMTP_FROM: ""
  MAILTRAP_API_KEY: ""
  MAILTRAP_FROM: ""
  MAILTRAP_SANDBOX_ID: ""
  PAWAPAY_API_KEY: ""
  PAWAPAY_CALLBACK_URL: ""
  PAWAPAY_CALLBACK_IPS: ""
  KPAY_API_KEY: ""
  KPAY_SECRET_KEY: ""
  KPAY_WEBHOOK_SECRET: ""
  KPAY_CALLBACK_URL: ""
  KPAY_PAYOUT_CALLBACK_URL: ""
  KPAY_REFUND_CALLBACK_URL: ""
  FIREBASE_PROJECT_ID: ""
