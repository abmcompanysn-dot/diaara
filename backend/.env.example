# Copie ce fichier en .env.local et renseigne les vraies valeurs.
# Ne jamais commiter de secret dans git.

# === Connexion PostgreSQL ===
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# === JWT ===
# Minimum 32 caractères, générer avec: openssl rand -base64 48
JWT_SECRET=
# Distinct de JWT_SECRET
REFRESH_SECRET=

# === URL publique du frontend ===
# Utilisée pour les liens dans les emails (vérification, reset) et
# pour la redirection des liens d'affiliation /r/{slug}.
FRONTEND_URL=

# === Secret proxy de confiance (rate limiting) ===
# Optionnel mais RECOMMANDÉ en prod (audit sécurité 2026-09-11) : sans lui,
# n'importe qui peut poser lui-même CF-Connecting-IP/X-Real-IP et se faire
# passer pour une IP différente à chaque requête, ce qui annule le rate
# limiting (dont la limite anti-brute-force sur /api/auth/login). Si posé,
# ces en-têtes ne sont honorés que si la requête porte aussi
# X-Diarra-Origin-Secret avec cette même valeur — à faire poser par Caddy
# (le vrai bord internet en prod) sur tout ce qu'il transmet à l'ingress,
# jamais atteignable depuis l'extérieur. Générer avec: openssl rand -hex 32
TRUSTED_PROXY_SECRET=

# === Cache Redis (catalogue, stats admin, solde vendeur, rate limiting) ===
# Optionnel : vide = cache désactivé (no-op), tout continue de fonctionner
# directement sur la base de données, juste sans mise en cache.
REDIS_URL=redis://localhost:6379

# === Emails (un seul fournisseur actif) ===
# Option 1 — SMTP (recommandé en production)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Option 2 — Resend
RESEND_API_KEY=
RESEND_FROM=
# Option 3 — Mailtrap (sandbox, développement)
MAILTRAP_API_KEY=
MAILTRAP_SANDBOX_ID=
MAILTRAP_FROM=

# === Stockage objet (fichiers produits vendus) — S3-compatible ===
# Recommandé: Tigris Data (gratuit 5 Go, 0 frais egress, sans carte requise).
# Créer un bucket + clés sur https://console.storage.dev
# Endpoint Tigris: https://fly.storage.tigris.dev (ou https://t3.storage.dev)
# Compatible aussi avec MinIO local ou R2 (mettre l'endpoint correspondant).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# === Connexion Google (Firebase Auth) — à configurer plus tard ===
# Créer un projet sur console.firebase.google.com, activer Google dans
# Authentication > Sign-in method. Le backend vérifie lui-même les jetons
# (endpoint public Google), aucune clé de service n'est nécessaire ici.
# FIREBASE_PROJECT_ID=

# === Paiement PawaPay (mobile money, versements vendeur) ===
# Créer un compte sur pawapay.io puis renseigner les clés. BASE_URL défaut
# sandbox (https://api.sandbox.pawapay.io) si laissé vide — mettre
# https://api.pawapay.io en production. CALLBACK_IPS: liste blanche IP
# (séparée par des virgules) des webhooks PawaPay entrants, en plus de la
# vérification Content-Digest — SANS ÇA, /api/webhooks/pawapay* accepte une
# requête de n'importe qui sur Internet (Content-Digest ne prouve que
# l'intégrité du corps, pas son origine). IMPORTANT à poser en prod (audit
# sécurité 2026-09-11) : IPs source publiées par PawaPay au 2026-09-11
# (https://docs.pawapay.io/using_the_api — à revérifier périodiquement,
# PawaPay peut les faire évoluer) :
# Sandbox    : 3.64.89.224
# Production : 18.192.208.15,18.195.113.136,3.72.212.107,54.73.125.42,54.155.38.214,54.73.130.113
PAWAPAY_API_KEY=
PAWAPAY_BASE_URL=
PAWAPAY_CALLBACK_URL=
PAWAPAY_CALLBACK_IPS=18.192.208.15,18.195.113.136,3.72.212.107,54.73.125.42,54.155.38.214,54.73.130.113

# === Paiement KPay — SUSPENDU le 2026-09-03 (voir main.go) ===
# Le client n'est plus instancié (kpay reste nil) : renseigner ces clés n'a
# plus d'effet tant que la construction du client n'est pas réintroduite dans
# main.go. Code laissé en place (kpay.go, adaptateur, handlers, webhooks)
# pour une réactivation éventuelle. Carte bancaire/PayPal est repris par
# PayPal (bloc ci-dessous), le mobile money reste sur PawaPay seul.
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_BASE_URL=
KPAY_WEBHOOK_SECRET=
KPAY_CALLBACK_URL=
KPAY_PAYOUT_CALLBACK_URL=
KPAY_REFUND_CALLBACK_URL=

# === Paiement PayPal (carte bancaire + compte PayPal au checkout) ===
# Remplace KPay pour ce flux. Orders API v2, sandbox par défaut. Créer une
# app sur developer.paypal.com (Sandbox puis Live) pour obtenir Client
# ID/Secret ; créer un webhook (Dashboard > mon app > Add Webhook) écoutant
# au minimum CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED et
# PAYMENT.CAPTURE.REFUNDED, pointant vers <FRONTEND_URL ou API>/webhooks/paypal
# — copier l'ID du webhook créé dans PAYPAL_WEBHOOK_ID (sert à vérifier les
# webhooks entrants auprès de l'API PayPal, pas de HMAC local possible).
# BASE_URL défaut https://api-m.sandbox.paypal.com si laissé vide — mettre
# https://api-m.paypal.com en production (et recréer un webhook Live, les
# IDs sandbox/live sont distincts).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=
PAYPAL_WEBHOOK_ID=
