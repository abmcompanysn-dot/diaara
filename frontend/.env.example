# Copie ce fichier en .env.local et adapte si besoin.
# Ces variables sont publiques (NEXT_PUBLIC_*) et embarquées au build.

# URL de l'API backend (défaut localhost si non renseignée)
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL du websocket temps réel (défaut ws://localhost:8080 si non renseignée)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# URL publique du site (utilisée pour le sitemap.xml et les URLs canoniques)
NEXT_PUBLIC_SITE_URL=https://diarra.app

# === Firebase (connexion Google + messagerie client-vendeur) — optionnel ===
# Config du projet Firebase : console.firebase.google.com > Paramètres du
# projet > Général > "Vos applications" > app Web (icône </>). Tant que ces
# variables sont vides, le bouton "Continuer avec Google" et le chat restent
# masqués côté frontend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Réseaux sociaux — optionnel ===
# Tant que vide, l'icône TikTok du footer reste masquée.
NEXT_PUBLIC_TIKTOK_URL=

# === Notifications push (Web Push + VAPID) — optionnel ===
# Clé PUBLIQUE générée avec `npx web-push generate-vapid-keys` (voir
# backend/.env.example) — même valeur des deux côtés, la clé privée ne va
# JAMAIS ici. Tant que vide, l'abonnement push reste désactivé côté client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=




