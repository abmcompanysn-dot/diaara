{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Doit correspondre au Worker déjà créé/connecté sur le dashboard
  // Cloudflare (sinon wrangler tente de créer un second Worker au lieu de
  // mettre à jour l'existant).
  "name": "diaara",
  "compatibility_date": "2026-01-01",
  "main": "src/index.ts",

  // Frontend statique exporté (Next.js output: export), servi par env.ASSETS.
  // run_worker_first: le Worker gère TOUTES les requêtes (proxy API/WS + /r/,
  // rate-limit) puis sert les assets via env.ASSETS.fetch.
  //
  // "./out" (et non "../frontend/out") : le build Cloudflare (Workers
  // Builds, dashboard Git-connecté) exécute la commande de build et la
  // commande de déploiement dans deux phases qui ne partagent pas forcément
  // les fichiers écrits EN DEHORS du répertoire racine configuré — la
  // commande de build copie donc le résultat du build Next.js ici, à
  // l'intérieur de worker/, pour que ce soit fiable quelle que soit la
  // sémantique exacte du "Root directory" côté Cloudflare.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },

  "vars": {
    // Backend Go sur le VPS (169.58.214.115), joignable via api.diarra.app
    // — sous-domaine Cloudflare proxied (nuage orange) : le fetch() de ce
    // Worker vers cette adresse reste dans le réseau Cloudflare, donc le
    // certificat self-signed de Caddy (mode SSL "Full") est accepté.
    // origin.abmcy.com (Vercel DNS -> VPS) donnait un 526 : le fetch() du
    // Worker valide le certificat d'origine en strict, indépendamment du
    // mode SSL de la zone.
    "BACKEND_URL": "https://api.diarra.app"
  },

  // Route de production — nouveau domaine dédié à l'application (distinct
  // de diarra.abmcy.com, qui reste géré chez Hostinger sans changement,
  // donc aucun risque pour le mail Mailcow hébergé sur le même domaine).
  // Avant ça, déployer et tester sur le sous-domaine *.workers.dev par défaut.
  // "routes": [
  //   { "pattern": "diarra.app/*", "zone_name": "diarra.app" }
  // ],

  "kv_namespaces": [
    { "binding": "RATE_LIMITS", "id": "7a5a5deb1c6744c2a9740c4c10b52a25" }
  ]
}
