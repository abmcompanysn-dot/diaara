{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diarra-worker",
  "compatibility_date": "2026-01-01",
  "main": "src/index.ts",

  // Frontend statique exporté (Next.js output: export), servi par env.ASSETS.
  // run_worker_first: le Worker gère TOUTES les requêtes (proxy API/WS + /r/,
  // rate-limit) puis sert les assets via env.ASSETS.fetch.
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },

  "vars": {
    // Backend Go sur le VPS, atteint via un sous-domaine dédié NON proxifié
    // par Cloudflare (DNS-only) — diarra.abmcy.com est le Worker lui-même
    // une fois la route branchée, l'utiliser ici créerait une boucle infinie.
    "BACKEND_URL": "https://origin.abmcy.com"
  },

  // Route de production — à activer une fois le DNS de abmcy.com basculé
  // sur Cloudflare (voir plan de migration). Avant ça, déployer et tester
  // sur le sous-domaine *.workers.dev par défaut.
  // "routes": [
  //   { "pattern": "diarra.abmcy.com/*", "zone_name": "abmcy.com" }
  // ],

  "kv_namespaces": [
    { "binding": "RATE_LIMITS", "id": "a07ad8fee1694782af048ca6eb17981f" }
  ]
}
