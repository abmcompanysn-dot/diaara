{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diarra-worker",
  "compatibility_date": "2026-01-01",
  "main": "src/index.ts",

  "vars": {
    // URL du backend (via tunnel/docker au déploiement).
    "BACKEND_URL": "http://backend:8080"
  },

  // Domaines personnalisés — à configurer au déploiement (ex. api.diarra.sn).
  // "routes": [
  //   { "pattern": "api.diarra.sn", "zone_name": "diarra.sn" }
  // ],

  "kv_namespaces": [
    { "binding": "RATE_LIMITS", "id": "a07ad8fee1694782af048ca6eb17981f" }
  ],

  "queues": {
    "producers": [
      { "queue": "diarra-delivery", "binding": "DELIVERY_QUEUE" }
    ],
    "consumers": [
      { "queue": "diarra-delivery", "max_batch_size": 10 }
    ]
  }
}
